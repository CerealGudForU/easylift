{
  "expo": {
    "name": "EasyLift",
    "slug": "easylift",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "easylift",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.cerealgudforu.easylift",
      "versionCode": 100,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 37,
            "targetSdkVersion": 37
          }
        }
      ],
      "./plugins/with-android-cmake.js",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/barlow-condensed/600SemiBold/BarlowCondensed_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/barlow-condensed/700Bold/BarlowCondensed_700Bold.ttf",
            "node_modules/@expo-google-fonts/barlow/400Regular/Barlow_400Regular.ttf",
            "node_modules/@expo-google-fonts/barlow/500Medium/Barlow_500Medium.ttf",
            "node_modules/@expo-google-fonts/barlow/600SemiBold/Barlow_600SemiBold.ttf"
          ]
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "EasyLift uses your photos so you can add one to a workout.",
          "cameraPermission": "EasyLift uses the camera so you can add a photo to a workout."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
